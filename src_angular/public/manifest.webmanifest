{
  "id": "./",
  "name": "Tirages de Noël",
  "short_name": "Noël",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8f6f1",
  "theme_color": "#1b4332",
  "share_target": {
    "action": "api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/gif", "image/webp"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
